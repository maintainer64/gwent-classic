{
  "name": "gwent-classic-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node sync-assets.mjs",
    "dev": "vite",
    "prebuild": "node sync-assets.mjs",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format": "prettier --write src/app src/features src/ui src/i18n src/domain src/api src/main.tsx tests *.ts sync-assets.mjs",
    "format:check": "prettier --check src/app src/features src/ui src/i18n src/domain src/api src/main.tsx tests *.ts sync-assets.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "3.9.10",
    "typescript": "5.8.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "motion": "14.5.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
